<Window x:Class="WindowsPhoneNextBuildTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows Phone Next - Build Tool"
        Height="700"
        Width="900"
        MinHeight="600"
        MinWidth="800"
        Background="{StaticResource PrimaryBackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        Icon="icon.ico">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Windows Phone Next"
                       FontSize="32"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="Build Tool &amp; Image Creator"
                       FontSize="18"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <!-- ISO Selection Section -->
        <Border Grid.Row="1"
                Background="{StaticResource SecondaryBackgroundBrush}"
                CornerRadius="8"
                Padding="20"
                Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="Windows 11 ISO"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="0,0,0,10"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="IsoPathTextBox"
                             Grid.Column="0"
                             Style="{StaticResource ModernTextBox}"
                             IsReadOnly="True"
                             Text="No ISO selected - will download automatically"
                             Margin="0,0,10,0"/>

                    <Button x:Name="BrowseIsoButton"
                            Grid.Column="1"
                            Content="Browse..."
                            Style="{StaticResource SecondaryButton}"
                            Click="BrowseIsoButton_Click"
                            Width="120"/>
                </Grid>

                <CheckBox x:Name="DownloadIsoCheckBox"
                          Content="Automatically download Windows 11 IoT Enterprise LTSC if not provided"
                          Style="{StaticResource ModernCheckBox}"
                          IsChecked="True"
                          Margin="0,12,0,0"/>
            </StackPanel>
        </Border>

        <!-- Build Options Section -->
        <Border Grid.Row="2"
                Background="{StaticResource SecondaryBackgroundBrush}"
                CornerRadius="8"
                Padding="20"
                Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="Build Options"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="0,0,0,10"/>

                <CheckBox x:Name="CleanBuildCheckBox"
                          Content="Clean build (remove previous build artifacts)"
                          Style="{StaticResource ModernCheckBox}"
                          Margin="0,0,0,8"/>

                <CheckBox x:Name="BuildAppsCheckBox"
                          Content="Build all Windows Phone applications (19 apps)"
                          Style="{StaticResource ModernCheckBox}"
                          IsChecked="True"
                          Margin="0,0,0,8"/>

                <CheckBox x:Name="DownloadDriversCheckBox"
                          Content="Download and integrate LattePanda 3 Delta drivers"
                          Style="{StaticResource ModernCheckBox}"
                          IsChecked="True"
                          Margin="0,0,0,8"/>

                <CheckBox x:Name="CreateImageCheckBox"
                          Content="Create bootable Windows Phone Next ISO image"
                          Style="{StaticResource ModernCheckBox}"
                          IsChecked="True"
                          Margin="0,0,0,8"/>

                <CheckBox x:Name="CreateUsbCheckBox"
                          Content="Generate USB creation script (create-usb.ps1)"
                          Style="{StaticResource ModernCheckBox}"
                          IsChecked="True"/>
            </StackPanel>
        </Border>

        <!-- Progress and Log Section -->
        <Border Grid.Row="3"
                Background="{StaticResource SecondaryBackgroundBrush}"
                CornerRadius="8"
                Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="StatusTextBlock"
                           Grid.Row="0"
                           Text="Ready to build"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="0,0,0,10"/>

                <ProgressBar x:Name="MainProgressBar"
                             Grid.Row="1"
                             Style="{StaticResource ModernProgressBar}"
                             Height="12"
                             Minimum="0"
                             Maximum="100"
                             Value="0"
                             Margin="0,0,0,8"/>

                <TextBlock x:Name="ProgressTextBlock"
                           Grid.Row="2"
                           Text="0%"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,0,15"/>

                <Border Grid.Row="3"
                        Background="{StaticResource PrimaryBackgroundBrush}"
                        CornerRadius="4"
                        Padding="10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="LogTextBlock"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Text="Build log will appear here..."/>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>

        <!-- Action Buttons -->
        <Grid Grid.Row="4" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button x:Name="OpenOutputButton"
                        Content="Open Output Folder"
                        Style="{StaticResource SecondaryButton}"
                        Click="OpenOutputButton_Click"
                        Margin="0,0,10,0"
                        Width="160"/>

                <Button x:Name="OpenBuildFolderButton"
                        Content="Open Build Folder"
                        Style="{StaticResource SecondaryButton}"
                        Click="OpenBuildFolderButton_Click"
                        Width="160"/>
            </StackPanel>

            <Button x:Name="CancelButton"
                    Grid.Column="1"
                    Content="Cancel"
                    Style="{StaticResource SecondaryButton}"
                    Click="CancelButton_Click"
                    Width="120"
                    Margin="0,0,10,0"
                    IsEnabled="False"/>

            <Button x:Name="BuildButton"
                    Grid.Column="2"
                    Content="Start Build"
                    Style="{StaticResource ModernButton}"
                    Click="BuildButton_Click"
                    Width="150"/>
        </Grid>
    </Grid>
</Window>
