<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Claude Code Theme Colors -->
    <Color x:Key="BackgroundColor">#1A1A2E</Color>
    <Color x:Key="SurfaceColor">#16213E</Color>
    <Color x:Key="CardColor">#1F2B47</Color>

    <!-- Claude Orange Accent -->
    <Color x:Key="AccentColor">#FF6B35</Color>
    <Color x:Key="AccentLightColor">#FF8C5A</Color>
    <Color x:Key="AccentDarkColor">#E55A2B</Color>

    <!-- Message Colors -->
    <Color x:Key="UserMessageColor">#FF6B35</Color>
    <Color x:Key="AssistantMessageColor">#2D3A5A</Color>

    <!-- Text Colors -->
    <Color x:Key="TextPrimaryColor">#FFFFFF</Color>
    <Color x:Key="TextSecondaryColor">#9CA3AF</Color>
    <Color x:Key="TextMutedColor">#6B7280</Color>

    <!-- Status Colors -->
    <Color x:Key="SuccessColor">#10B981</Color>
    <Color x:Key="ErrorColor">#EF4444</Color>
    <Color x:Key="WarningColor">#F59E0B</Color>

    <!-- Input Colors -->
    <Color x:Key="InputBackgroundColor">#0F1629</Color>
    <Color x:Key="InputBorderColor">#374151</Color>
    <Color x:Key="InputFocusBorderColor">#FF6B35</Color>

    <!-- Button Colors -->
    <Color x:Key="ButtonPrimaryColor">#FF6B35</Color>
    <Color x:Key="ButtonSecondaryColor">#374151</Color>
    <Color x:Key="ButtonDisabledColor">#4B5563</Color>

</ResourceDictionary>
