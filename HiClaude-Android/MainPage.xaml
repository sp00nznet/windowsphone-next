<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:ClaudeCodeAndroid.ViewModels"
             xmlns:models="clr-namespace:ClaudeCodeAndroid.Models"
             x:Class="ClaudeCodeAndroid.MainPage"
             x:DataType="viewmodels:ChatViewModel"
             BackgroundColor="{StaticResource BackgroundColor}">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <Border Grid.Row="0"
                BackgroundColor="{StaticResource SurfaceColor}"
                Padding="16,12"
                StrokeThickness="0">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- App Icon -->
                <Frame Grid.Column="0"
                       BackgroundColor="{StaticResource AccentColor}"
                       CornerRadius="20"
                       WidthRequest="40"
                       HeightRequest="40"
                       Padding="0"
                       HasShadow="False">
                    <Label Text="🤖"
                           FontSize="20"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Frame>

                <!-- Title and Status -->
                <VerticalStackLayout Grid.Column="1"
                                     Margin="12,0"
                                     VerticalOptions="Center">
                    <Label Text="Claude Code"
                           Style="{StaticResource TitleLabel}"
                           FontSize="18" />
                    <Label Text="{Binding StatusText}"
                           Style="{StaticResource SubtitleLabel}"
                           FontSize="12" />
                </VerticalStackLayout>

                <!-- Settings Button -->
                <Button Grid.Column="2"
                        Text="⚙️"
                        FontSize="20"
                        BackgroundColor="Transparent"
                        Command="{Binding ToggleSettingsCommand}"
                        WidthRequest="44"
                        HeightRequest="44" />
            </Grid>
        </Border>

        <!-- Chat Messages -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Messages}"
                        Margin="8,8,8,0"
                        x:Name="MessagesCollectionView">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:ChatMessage">
                    <Grid Margin="0,4">
                        <Frame Style="{StaticResource UserMessageFrame}"
                               HorizontalOptions="End"
                               MaximumWidthRequest="300"
                               IsVisible="{Binding IsUser}">
                            <Label Text="{Binding Content}"
                                   TextColor="{StaticResource TextPrimaryColor}"
                                   FontSize="15" />
                        </Frame>
                        <Frame Style="{StaticResource AssistantMessageFrame}"
                               HorizontalOptions="Start"
                               MaximumWidthRequest="300"
                               IsVisible="{Binding IsUser, Converter={StaticResource InvertedBoolConverter}}">
                            <Label Text="{Binding Content}"
                                   TextColor="{StaticResource TextPrimaryColor}"
                                   FontSize="15" />
                        </Frame>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Settings Panel (Overlay) -->
        <Border Grid.Row="1"
                BackgroundColor="{StaticResource SurfaceColor}"
                Margin="16"
                Padding="16"
                StrokeThickness="0"
                IsVisible="{Binding IsSettingsVisible}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="16" />
            </Border.StrokeShape>
            <ScrollView>
                <VerticalStackLayout Spacing="16">
                    <Label Text="Repository Settings"
                           Style="{StaticResource TitleLabel}"
                           FontSize="20" />

                    <!-- Provider Picker -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Git Provider"
                               Style="{StaticResource SubtitleLabel}" />
                        <Picker ItemsSource="{Binding Providers}"
                                SelectedItem="{Binding SelectedProvider}"
                                BackgroundColor="{StaticResource InputBackgroundColor}"
                                TextColor="{StaticResource TextPrimaryColor}" />
                    </VerticalStackLayout>

                    <!-- Repository URL -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Repository URL / Owner/Repo"
                               Style="{StaticResource SubtitleLabel}" />
                        <Entry Text="{Binding RepositoryUrl}"
                               Placeholder="e.g., owner/repo or full URL"
                               Style="{StaticResource ChatEntry}" />
                    </VerticalStackLayout>

                    <!-- Local Path -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Local Path (optional)"
                               Style="{StaticResource SubtitleLabel}" />
                        <Entry Text="{Binding LocalPath}"
                               Placeholder="/path/to/local/repo"
                               Style="{StaticResource ChatEntry}" />
                    </VerticalStackLayout>

                    <!-- Save Button -->
                    <Button Text="Save Repository"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding SaveRepositoryCommand}" />

                    <!-- Saved Repositories -->
                    <Label Text="Saved Repositories"
                           Style="{StaticResource SubtitleLabel}"
                           Margin="0,8,0,0" />

                    <CollectionView ItemsSource="{Binding SavedRepositories}"
                                    HeightRequest="200">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Repository">
                                <SwipeView>
                                    <SwipeView.RightItems>
                                        <SwipeItems>
                                            <SwipeItem Text="Delete"
                                                       BackgroundColor="{StaticResource ErrorColor}"
                                                       Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ChatViewModel}}, Path=DeleteRepositoryCommand}"
                                                       CommandParameter="{Binding .}" />
                                        </SwipeItems>
                                    </SwipeView.RightItems>
                                    <Border BackgroundColor="{StaticResource CardColor}"
                                            Padding="12"
                                            Margin="0,4"
                                            StrokeThickness="0">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8" />
                                        </Border.StrokeShape>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ChatViewModel}}, Path=SelectRepositoryCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <VerticalStackLayout Grid.Column="0">
                                                <Label Text="{Binding Name}"
                                                       TextColor="{StaticResource TextPrimaryColor}"
                                                       FontSize="14"
                                                       FontAttributes="Bold" />
                                                <Label Text="{Binding Provider}"
                                                       TextColor="{StaticResource TextSecondaryColor}"
                                                       FontSize="12" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="1"
                                                   Text="→"
                                                   TextColor="{StaticResource TextSecondaryColor}"
                                                   FontSize="16"
                                                   VerticalOptions="Center" />
                                        </Grid>
                                    </Border>
                                </SwipeView>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- Close Settings -->
                    <Button Text="Close"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding ToggleSettingsCommand}" />
                </VerticalStackLayout>
            </ScrollView>
        </Border>

        <!-- Input Area -->
        <Border Grid.Row="2"
                BackgroundColor="{StaticResource SurfaceColor}"
                Padding="12"
                StrokeThickness="0">
            <Grid ColumnDefinitions="*,Auto,Auto"
                  ColumnSpacing="8">
                <!-- Text Input -->
                <Entry Grid.Column="0"
                       Text="{Binding MessageText}"
                       Placeholder="Type a message..."
                       Style="{StaticResource ChatEntry}"
                       ReturnCommand="{Binding SendMessageCommand}"
                       ReturnType="Send" />

                <!-- Microphone Button -->
                <Button Grid.Column="1"
                        Text="{Binding IsListening, Converter={StaticResource ListeningIconConverter}}"
                        FontSize="20"
                        BackgroundColor="{Binding IsListening, Converter={StaticResource ListeningColorConverter}}"
                        Command="{Binding ToggleListeningCommand}"
                        WidthRequest="48"
                        HeightRequest="48"
                        CornerRadius="24" />

                <!-- Send Button -->
                <Button Grid.Column="2"
                        Text="➤"
                        FontSize="18"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding SendMessageCommand}"
                        WidthRequest="48"
                        HeightRequest="48"
                        CornerRadius="24"
                        Padding="0" />
            </Grid>
        </Border>

        <!-- Processing Indicator -->
        <Border Grid.Row="1"
                BackgroundColor="#80000000"
                IsVisible="{Binding IsProcessing}"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Padding="24"
                StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>
            <VerticalStackLayout Spacing="12"
                                 HorizontalOptions="Center">
                <ActivityIndicator IsRunning="{Binding IsProcessing}"
                                   Color="{StaticResource AccentColor}"
                                   HeightRequest="40"
                                   WidthRequest="40" />
                <Label Text="Thinking..."
                       TextColor="{StaticResource TextPrimaryColor}"
                       FontSize="14" />
            </VerticalStackLayout>
        </Border>

    </Grid>

</ContentPage>
