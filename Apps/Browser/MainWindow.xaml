<Window x:Class="WindowsPhoneNext.Browser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Browser"
        Width="720" Height="720"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Loaded="Window_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Bar -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                       Content="&#x2190;"
                       Background="Transparent"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       BorderThickness="0"
                       FontSize="24"
                       Cursor="Hand"
                       Click="CloseButton_Click"/>

                <TextBlock Grid.Column="1"
                          Text="Browser"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          FontSize="18"
                          FontWeight="SemiBold"
                          Foreground="{StaticResource TextPrimaryBrush}"/>
            </Grid>
        </Border>

        <!-- Navigation Bar -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" Padding="8,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Back -->
                <Button x:Name="BackButton"
                       Grid.Column="0"
                       Style="{StaticResource NavButtonStyle}"
                       Click="BackButton_Click"
                       IsEnabled="False"
                       ToolTip="Back">
                    <TextBlock Text="&#x2190;" FontSize="18"/>
                </Button>

                <!-- Forward -->
                <Button x:Name="ForwardButton"
                       Grid.Column="1"
                       Style="{StaticResource NavButtonStyle}"
                       Click="ForwardButton_Click"
                       IsEnabled="False"
                       ToolTip="Forward">
                    <TextBlock Text="&#x2192;" FontSize="18"/>
                </Button>

                <!-- Refresh -->
                <Button x:Name="RefreshButton"
                       Grid.Column="2"
                       Style="{StaticResource NavButtonStyle}"
                       Click="RefreshButton_Click"
                       ToolTip="Refresh">
                    <TextBlock Text="&#x21BB;" FontSize="18"/>
                </Button>

                <!-- URL Bar -->
                <TextBox x:Name="UrlBar"
                        Grid.Column="3"
                        Style="{StaticResource UrlBarStyle}"
                        Margin="8,0"
                        Text="https://www.google.com"
                        KeyDown="UrlBar_KeyDown"/>

                <!-- Go -->
                <Button Grid.Column="4"
                       Style="{StaticResource NavButtonStyle}"
                       Click="GoButton_Click"
                       ToolTip="Go">
                    <TextBlock Text="&#x2192;" FontSize="18"/>
                </Button>
            </Grid>
        </Border>

        <!-- WebView Container -->
        <Grid Grid.Row="2">
            <!-- WebView2 -->
            <wv2:WebView2 x:Name="WebView"
                         DefaultBackgroundColor="Transparent"/>

            <!-- Loading Overlay -->
            <Border x:Name="LoadingOverlay"
                   Background="#80000000"
                   Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Loading..."
                              FontSize="18"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              HorizontalAlignment="Center"/>
                    <ProgressBar IsIndeterminate="True"
                                Width="200"
                                Height="4"
                                Margin="0,16,0,0"
                                Background="{StaticResource CardBrush}"
                                Foreground="{StaticResource PrimaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- Error Overlay -->
            <Border x:Name="ErrorOverlay"
                   Background="{StaticResource BackgroundBrush}"
                   Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="&#x26A0;"
                              FontSize="64"
                              Foreground="{StaticResource ErrorBrush}"
                              HorizontalAlignment="Center"/>
                    <TextBlock x:Name="ErrorText"
                              Text="Failed to load page"
                              FontSize="18"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              HorizontalAlignment="Center"
                              Margin="0,16,0,0"/>
                    <Button Content="Try Again"
                           Margin="0,24,0,0"
                           Padding="24,12"
                           Background="{StaticResource PrimaryBrush}"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           BorderThickness="0"
                           FontSize="14"
                           Cursor="Hand"
                           Click="RetryButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Bookmarks Panel (slide in from bottom) -->
        <Border x:Name="BookmarksPanel"
               Grid.Row="2"
               Background="{StaticResource SurfaceBrush}"
               VerticalAlignment="Bottom"
               Height="300"
               Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="{StaticResource CardBrush}" BorderThickness="0,0,0,1">
                    <Grid Margin="16,0">
                        <TextBlock Text="Bookmarks"
                                  FontSize="16"
                                  FontWeight="SemiBold"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  VerticalAlignment="Center"/>
                        <Button Content="&#x2715;"
                               HorizontalAlignment="Right"
                               Background="Transparent"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               BorderThickness="0"
                               FontSize="18"
                               Cursor="Hand"
                               Click="CloseBookmarks_Click"/>
                    </Grid>
                </Border>

                <ListView x:Name="BookmarksList"
                         Grid.Row="1"
                         Background="Transparent"
                         BorderThickness="0"
                         SelectionChanged="BookmarksList_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4" Cursor="Hand">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                          Text="&#128278;"
                                          FontSize="20"
                                          VerticalAlignment="Center"/>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}"
                                              FontSize="14"
                                              Foreground="{StaticResource TextPrimaryBrush}"
                                              TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Url}"
                                              FontSize="11"
                                              Foreground="{StaticResource TextSecondaryBrush}"
                                              TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Window>
