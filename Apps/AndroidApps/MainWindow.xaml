<Window x:Class="WindowsPhoneNext.AndroidApps.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Android Apps"
        Width="720" Height="1560"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Loaded="Window_Loaded"
        KeyDown="Window_KeyDown">

    <!-- Bezel-safe container with curved corners -->
    <Border Style="{StaticResource BezelWindowBorderStyle}"
            Background="{StaticResource BackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header with bezel-safe margins -->
            <Border Grid.Row="0" Style="{StaticResource BezelStatusBarStyle}" Background="{StaticResource SurfaceBrush}">
                <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                       Style="{StaticResource BackButtonStyle}"
                       Content="&#x2190;"
                       FontSize="24"
                       Click="BackButton_Click"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#129302;"
                              FontSize="24"
                              VerticalAlignment="Center"
                              Margin="0,0,8,0"/>
                    <TextBlock Text="Android Apps"
                              FontSize="20"
                              FontWeight="SemiBold"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              VerticalAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="2"
                       Style="{StaticResource BackButtonStyle}"
                       Content="&#128260;"
                       FontSize="20"
                       Click="RefreshButton_Click"
                       ToolTip="Refresh"/>
            </Grid>
        </Border>

        <!-- Status Bar -->
        <Border Grid.Row="1" Background="{StaticResource CardBrush}" Margin="16,16,16,0" CornerRadius="12" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Ellipse x:Name="StatusIndicator"
                        Grid.Column="0"
                        Width="12" Height="12"
                        Fill="{StaticResource ErrorBrush}"
                        Margin="0,0,12,0"/>

                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="StatusText"
                              Text="Windows Subsystem for Android"
                              FontSize="14"
                              FontWeight="SemiBold"
                              Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="StatusDescription"
                              Text="Checking status..."
                              FontSize="12"
                              Foreground="{StaticResource TextSecondaryBrush}"
                              Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="2" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Section Header -->
            <TextBlock Grid.Row="0"
                      Text="Installed Android Apps"
                      FontSize="16"
                      FontWeight="SemiBold"
                      Foreground="{StaticResource TextPrimaryBrush}"
                      Margin="0,16,0,12"/>

            <!-- App List -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                <StackPanel>
                    <!-- Apps will be added here -->
                    <ItemsControl x:Name="AppList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource AppCardStyle}"
                                       Margin="0,0,0,8"
                                       Tag="{Binding PackageName}"
                                       Click="AppItem_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="56"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- App Icon -->
                                        <Border Grid.Column="0"
                                               Width="48" Height="48"
                                               CornerRadius="12"
                                               Background="{StaticResource PrimaryBrush}">
                                            <TextBlock Text="{Binding IconText}"
                                                      FontSize="24"
                                                      Foreground="#000000"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- App Info -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                      FontSize="16"
                                                      Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding PackageName}"
                                                      FontSize="12"
                                                      Foreground="{StaticResource TextSecondaryBrush}"
                                                      TextTrimming="CharacterEllipsis"
                                                      Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- Launch Arrow -->
                                        <TextBlock Grid.Column="2"
                                                  Text="&#9654;"
                                                  FontSize="16"
                                                  Foreground="{StaticResource TextSecondaryBrush}"
                                                  VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Empty State -->
                    <StackPanel x:Name="EmptyState"
                               HorizontalAlignment="Center"
                               Margin="0,60,0,0"
                               Visibility="Collapsed">
                        <TextBlock Text="&#128230;"
                                  FontSize="64"
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  HorizontalAlignment="Center"/>
                        <TextBlock Text="No Android Apps Installed"
                                  FontSize="18"
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  HorizontalAlignment="Center"
                                  Margin="0,16,0,0"/>
                        <TextBlock Text="Tap 'Install APK' to sideload an app"
                                  FontSize="14"
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  HorizontalAlignment="Center"
                                  Margin="0,8,0,0"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Bottom Actions -->
            <StackPanel Grid.Row="2" Margin="0,16,0,0">
                <Button x:Name="InstallButton"
                       Style="{StaticResource PrimaryButtonStyle}"
                       HorizontalAlignment="Stretch"
                       Click="InstallApk_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#128229;" FontSize="18" Margin="0,0,8,0"/>
                        <TextBlock Text="Install APK" FontSize="14" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource AppCardStyle}"
                       HorizontalAlignment="Stretch"
                       Margin="0,8,0,0"
                       Click="OpenWSASettings_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                  Text="&#9881;"
                                  FontSize="20"
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  Margin="0,0,12,0"/>
                        <TextBlock Grid.Column="1"
                                  Text="Open WSA Settings"
                                  FontSize="14"
                                  Foreground="{StaticResource TextPrimaryBrush}"/>
                    </Grid>
                </Button>

                <TextBlock Text="Requires Windows Subsystem for Android"
                          FontSize="11"
                          Foreground="{StaticResource TextSecondaryBrush}"
                          HorizontalAlignment="Center"
                          Margin="0,12,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Loading Overlay -->
        <Border x:Name="LoadingOverlay"
               Grid.RowSpan="3"
               Background="#E0000000"
               Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True"
                            Width="200"
                            Height="4"
                            Background="{StaticResource CardBrush}"
                            Foreground="{StaticResource PrimaryBrush}"/>
                <TextBlock x:Name="LoadingText"
                          Text="Installing..."
                          FontSize="16"
                          Foreground="{StaticResource TextPrimaryBrush}"
                          HorizontalAlignment="Center"
                          Margin="0,16,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
