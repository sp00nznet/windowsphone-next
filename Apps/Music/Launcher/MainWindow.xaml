<Window x:Class="WindowsPhoneNext.Music.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Music"
        Width="720" Height="1560"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Loaded="Window_Loaded"
        KeyDown="Window_KeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="180"/>
        </Grid.RowDefinitions>

        <!-- Top Bar with Back Button -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}">
            <Grid Margin="16,0">
                <Button Content="&#x2190;"
                       HorizontalAlignment="Left"
                       Background="Transparent"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       BorderThickness="0"
                       FontSize="24"
                       Cursor="Hand"
                       Click="BackButton_Click"/>
                <TextBlock Text="Music"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          FontSize="18"
                          FontWeight="SemiBold"
                          Foreground="{StaticResource TextPrimaryBrush}"/>
            </Grid>
        </Border>

        <!-- Visualizer Area -->
        <Grid Grid.Row="1" x:Name="VisualizerArea">
            <!-- Spectrum Analyzer Canvas -->
            <Canvas x:Name="SpectrumCanvas" Background="Transparent"/>

            <!-- Oscilloscope Canvas (overlay) -->
            <Canvas x:Name="OscilloscopeCanvas" Background="Transparent"/>

            <!-- Album Art / Track Info Overlay -->
            <StackPanel HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="{Binding ShowTrackInfo}">
                <Border Width="200" Height="200"
                       Background="{StaticResource CardBrush}"
                       CornerRadius="8"
                       Margin="0,0,0,20">
                    <TextBlock Text="&#127925;"
                              FontSize="80"
                              Foreground="{StaticResource TextSecondaryBrush}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="TrackTitleText"
                          Text="No Track Playing"
                          FontSize="24"
                          FontWeight="SemiBold"
                          Foreground="{StaticResource TextPrimaryBrush}"
                          HorizontalAlignment="Center"
                          TextTrimming="CharacterEllipsis"
                          MaxWidth="600"/>
                <TextBlock x:Name="ArtistText"
                          Text="Select a file to play"
                          FontSize="16"
                          Foreground="{StaticResource TextSecondaryBrush}"
                          HorizontalAlignment="Center"
                          Margin="0,8,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Player Controls -->
        <Grid Grid.Row="2" Background="{StaticResource SurfaceBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Progress Bar -->
            <Grid Grid.Row="0" Margin="20,16,20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="CurrentTimeText"
                          Grid.Column="0"
                          Text="0:00"
                          FontSize="12"
                          Foreground="{StaticResource TextSecondaryBrush}"
                          VerticalAlignment="Center"
                          Margin="0,0,12,0"/>

                <Slider x:Name="ProgressSlider"
                       Grid.Column="1"
                       Minimum="0" Maximum="100"
                       Value="0"
                       Style="{StaticResource ProgressSliderStyle}"
                       ValueChanged="ProgressSlider_ValueChanged"
                       PreviewMouseDown="ProgressSlider_PreviewMouseDown"
                       PreviewMouseUp="ProgressSlider_PreviewMouseUp"/>

                <TextBlock x:Name="TotalTimeText"
                          Grid.Column="2"
                          Text="0:00"
                          FontSize="12"
                          Foreground="{StaticResource TextSecondaryBrush}"
                          VerticalAlignment="Center"
                          Margin="12,0,0,0"/>
            </Grid>

            <!-- Transport Controls -->
            <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Shuffle -->
                <Button x:Name="ShuffleButton"
                       Grid.Column="0"
                       Style="{StaticResource TransportButtonStyle}"
                       Width="50" Height="50"
                       Click="ShuffleButton_Click">
                    <TextBlock Text="&#128256;" FontSize="20"/>
                </Button>

                <!-- Previous -->
                <Button Grid.Column="1"
                       Style="{StaticResource TransportButtonStyle}"
                       Margin="8,0"
                       Click="PreviousButton_Click">
                    <TextBlock Text="&#9198;" FontSize="24"/>
                </Button>

                <!-- Play/Pause -->
                <Button x:Name="PlayPauseButton"
                       Grid.Column="2"
                       Style="{StaticResource PlayButtonStyle}"
                       Click="PlayPauseButton_Click">
                    <TextBlock x:Name="PlayPauseIcon" Text="&#9654;" FontSize="32"/>
                </Button>

                <!-- Next -->
                <Button Grid.Column="3"
                       Style="{StaticResource TransportButtonStyle}"
                       Margin="8,0"
                       Click="NextButton_Click">
                    <TextBlock Text="&#9197;" FontSize="24"/>
                </Button>

                <!-- Repeat -->
                <Button x:Name="RepeatButton"
                       Grid.Column="4"
                       Style="{StaticResource TransportButtonStyle}"
                       Width="50" Height="50"
                       Click="RepeatButton_Click">
                    <TextBlock Text="&#128257;" FontSize="20"/>
                </Button>

                <!-- Open File -->
                <Button Grid.Column="5"
                       Style="{StaticResource TransportButtonStyle}"
                       Width="50" Height="50"
                       Margin="20,0,0,0"
                       Click="OpenFileButton_Click">
                    <TextBlock Text="&#128193;" FontSize="20"/>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Window>
