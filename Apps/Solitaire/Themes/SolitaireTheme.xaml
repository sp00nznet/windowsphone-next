<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Colors -->
    <Color x:Key="BackgroundColor">#0D5016</Color>
    <Color x:Key="SurfaceColor">#0A3D11</Color>
    <Color x:Key="CardColor">#FFFFFF</Color>
    <Color x:Key="CardBackColor">#1E3A8A</Color>
    <Color x:Key="RedSuitColor">#DC2626</Color>
    <Color x:Key="BlackSuitColor">#1F2937</Color>
    <Color x:Key="TextPrimaryColor">#FFFFFF</Color>
    <Color x:Key="TextSecondaryColor">#9CA3AF</Color>
    <Color x:Key="AccentColor">#F59E0B</Color>
    <Color x:Key="PrimaryColor">#0078D4</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}"/>
    <SolidColorBrush x:Key="CardBackBrush" Color="{StaticResource CardBackColor}"/>
    <SolidColorBrush x:Key="RedSuitBrush" Color="{StaticResource RedSuitColor}"/>
    <SolidColorBrush x:Key="BlackSuitBrush" Color="{StaticResource BlackSuitColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>

    <!-- Card Style -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Width" Value="85"/>
        <Setter Property="Height" Value="120"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Background" Value="{StaticResource CardBrush}"/>
        <Setter Property="BorderBrush" Value="#CCCCCC"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- Card Back Style -->
    <Style x:Key="CardBackStyle" TargetType="Border">
        <Setter Property="Width" Value="85"/>
        <Setter Property="Height" Value="120"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Background" Value="{StaticResource CardBackBrush}"/>
        <Setter Property="BorderBrush" Value="#1E3A8A"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- Empty Pile Style -->
    <Style x:Key="EmptyPileStyle" TargetType="Border">
        <Setter Property="Width" Value="85"/>
        <Setter Property="Height" Value="120"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="#FFFFFF30"/>
        <Setter Property="BorderThickness" Value="2"/>
    </Style>

    <!-- Button Style -->
    <Style x:Key="GameButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="0.9"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
