<Window x:Class="WindowsPhoneFiles.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Files"
        Width="720" Height="1560"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">

    <!-- Bezel-safe container with curved corners -->
    <Border Style="{StaticResource BezelWindowBorderStyle}"
            Background="{StaticResource BackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Status Bar with bezel-safe margins -->
            <Border Grid.Row="0" Style="{StaticResource BezelStatusBarStyle}" Background="{StaticResource SurfaceBrush}">
            <Grid>
                <TextBlock Text="12:00" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"
                           HorizontalAlignment="Left"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="📶" FontSize="12" Margin="0,0,8,0"/>
                    <TextBlock Text="🔋" FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Header with Navigation -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" Padding="8,8,8,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Nav Row -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="BackButton" Grid.Column="0" Content="←"
                            Style="{StaticResource NavButtonStyle}"
                            Click="BackButton_Click"/>
                    <Button x:Name="HomeButton" Grid.Column="1" Content="🏠"
                            Style="{StaticResource NavButtonStyle}"
                            Click="HomeButton_Click"/>

                    <TextBlock x:Name="PathText" Grid.Column="2"
                               Text="/storage"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="14"
                               VerticalAlignment="Center"
                               Margin="12,0"
                               TextTrimming="CharacterEllipsis"/>

                    <Button x:Name="MenuButton" Grid.Column="3" Content="⋮"
                            Style="{StaticResource NavButtonStyle}"
                            Click="MenuButton_Click"/>
                </Grid>

                <!-- Search Box -->
                <TextBox x:Name="SearchBox" Grid.Row="1"
                         TextChanged="SearchBox_TextChanged">
                    <TextBox.Resources>
                        <VisualBrush x:Key="HintBrush" TileMode="None" Stretch="None" AlignmentX="Left">
                            <VisualBrush.Visual>
                                <TextBlock Text="🔍 Search files..." Foreground="#6B7280" Margin="4,0,0,0"/>
                            </VisualBrush.Visual>
                        </VisualBrush>
                    </TextBox.Resources>
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource SearchBoxStyle}">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Background" Value="{StaticResource HintBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="2">
            <!-- Quick Access Panel -->
            <Border x:Name="QuickAccessPanel" Background="{StaticResource BackgroundBrush}"
                    Padding="16" Visibility="Visible">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Quick Access" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,16"/>

                        <Button Style="{StaticResource QuickAccessStyle}"
                                Click="QuickAccess_Click" Tag="Documents">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📄" FontSize="24" Margin="0,0,12,0"/>
                                <TextBlock Text="Documents" FontSize="16"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource QuickAccessStyle}"
                                Click="QuickAccess_Click" Tag="Downloads">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⬇️" FontSize="24" Margin="0,0,12,0"/>
                                <TextBlock Text="Downloads" FontSize="16"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource QuickAccessStyle}"
                                Click="QuickAccess_Click" Tag="Pictures">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🖼️" FontSize="24" Margin="0,0,12,0"/>
                                <TextBlock Text="Pictures" FontSize="16"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource QuickAccessStyle}"
                                Click="QuickAccess_Click" Tag="Music">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎵" FontSize="24" Margin="0,0,12,0"/>
                                <TextBlock Text="Music" FontSize="16"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource QuickAccessStyle}"
                                Click="QuickAccess_Click" Tag="Videos">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎬" FontSize="24" Margin="0,0,12,0"/>
                                <TextBlock Text="Videos" FontSize="16"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <TextBlock Text="Storage" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,24,0,16"/>

                        <Button Style="{StaticResource QuickAccessStyle}"
                                Click="QuickAccess_Click" Tag="Internal">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📱" FontSize="24" Margin="0,0,12,0"/>
                                <StackPanel>
                                    <TextBlock Text="Internal Storage" FontSize="16"/>
                                    <TextBlock x:Name="InternalStorageInfo"
                                               Text="Calculating..."
                                               FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <Button x:Name="SDCardButton" Style="{StaticResource QuickAccessStyle}"
                                Click="QuickAccess_Click" Tag="SDCard" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💾" FontSize="24" Margin="0,0,12,0"/>
                                <StackPanel>
                                    <TextBlock Text="SD Card" FontSize="16"/>
                                    <TextBlock x:Name="SDCardInfo"
                                               Text=""
                                               FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- File List -->
            <Border x:Name="FileListPanel" Background="{StaticResource BackgroundBrush}"
                    Visibility="Collapsed">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="FileList" Margin="8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource FileItemStyle}"
                                            MouseLeftButtonUp="FileItem_Click"
                                            Tag="{Binding}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Icon}"
                                                       FontSize="28"
                                                       Margin="0,0,16,0"
                                                       VerticalAlignment="Center"/>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="16"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Info}"
                                                           FontSize="12"
                                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </StackPanel>

                                            <Button Grid.Column="2"
                                                    Content="⋮"
                                                    Style="{StaticResource NavButtonStyle}"
                                                    Width="36" Height="36"
                                                    Click="FileMenu_Click"
                                                    Tag="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Empty State -->
                    <StackPanel x:Name="EmptyState" Visibility="Collapsed"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="📂" FontSize="64" HorizontalAlignment="Center"
                                   Margin="0,0,0,16"/>
                        <TextBlock Text="This folder is empty"
                                   FontSize="18"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom Action Bar -->
        <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="📁 New Folder"
                        Style="{StaticResource ActionButtonStyle}"
                        Click="NewFolder_Click"
                        Margin="0,0,8,0"/>

                <Button Grid.Column="1" Content="📋 Paste"
                        x:Name="PasteButton"
                        Style="{StaticResource ActionButtonStyle}"
                        Click="Paste_Click"
                        IsEnabled="False"
                        Margin="4,0"/>

                <Button Grid.Column="2" Content="✕ Close"
                        Style="{StaticResource ActionButtonStyle}"
                        Click="Close_Click"
                        Margin="8,0,0,0"/>
            </Grid>
        </Border>

        <!-- Context Menu Popup -->
        <Border x:Name="ContextMenu" Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                CornerRadius="12"
                Padding="8"
                Margin="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" Opacity="0.3" ShadowDepth="4"/>
            </Border.Effect>
            <StackPanel MinWidth="250">
                <Button Content="📋 Copy" Style="{StaticResource QuickAccessStyle}"
                        Click="ContextMenu_Copy"/>
                <Button Content="✂️ Cut" Style="{StaticResource QuickAccessStyle}"
                        Click="ContextMenu_Cut"/>
                <Button Content="✏️ Rename" Style="{StaticResource QuickAccessStyle}"
                        Click="ContextMenu_Rename"/>
                <Button Content="🗑️ Delete" Style="{StaticResource QuickAccessStyle}"
                        Click="ContextMenu_Delete"/>
                <Button Content="ℹ️ Properties" Style="{StaticResource QuickAccessStyle}"
                        Click="ContextMenu_Properties"/>
                <Button Content="✕ Cancel" Style="{StaticResource QuickAccessStyle}"
                        Click="ContextMenu_Cancel"/>
            </StackPanel>
        </Border>

    </Grid>
    </Border>
</Window>
