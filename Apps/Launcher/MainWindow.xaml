<Window x:Class="WindowsPhoneNext.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Windows Phone"
        Width="720" Height="1560"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Loaded="Window_Loaded"
        KeyDown="Window_KeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="100"/>
        </Grid.RowDefinitions>

        <!-- Status Bar -->
        <Border Grid.Row="0" Style="{StaticResource StatusBarStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Time -->
                <TextBlock x:Name="TimeText"
                          Text="12:00"
                          FontSize="20"
                          FontWeight="SemiBold"
                          Foreground="{StaticResource TextPrimaryBrush}"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Left"
                          Margin="16,0,0,0"/>

                <!-- Status Icons -->
                <StackPanel Grid.Column="1"
                           Orientation="Horizontal"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0">

                    <!-- Signal Strength -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                        <TextBlock x:Name="SignalText"
                                  Text="Signal"
                                  FontSize="12"
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0"/>
                        <Grid Width="24" Height="16" VerticalAlignment="Center">
                            <Rectangle Width="4" Height="4" Fill="{StaticResource TextSecondaryBrush}"
                                      HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                            <Rectangle Width="4" Height="8" Fill="{StaticResource TextSecondaryBrush}"
                                      HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6,0,0,0"/>
                            <Rectangle x:Name="Signal3" Width="4" Height="12" Fill="{StaticResource TextSecondaryBrush}"
                                      HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12,0,0,0"/>
                            <Rectangle x:Name="Signal4" Width="4" Height="16" Fill="{StaticResource TextSecondaryBrush}"
                                      HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="18,0,0,0"/>
                        </Grid>
                    </StackPanel>

                    <!-- Network -->
                    <TextBlock x:Name="NetworkText"
                              Text="LTE"
                              FontSize="12"
                              FontWeight="Bold"
                              Foreground="{StaticResource TextSecondaryBrush}"
                              VerticalAlignment="Center"
                              Margin="0,0,16,0"/>

                    <!-- Battery -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="BatteryText"
                                  Text="100%"
                                  FontSize="12"
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0"/>
                        <Border Width="28" Height="14"
                               BorderBrush="{StaticResource TextSecondaryBrush}"
                               BorderThickness="1"
                               CornerRadius="2"
                               VerticalAlignment="Center">
                            <Rectangle x:Name="BatteryLevel"
                                      Fill="{StaticResource SuccessBrush}"
                                      Width="24"
                                      HorizontalAlignment="Left"
                                      Margin="1"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Date Display -->
                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,40,0,60">
                    <TextBlock x:Name="DateText"
                              Text="Monday, January 13"
                              FontSize="28"
                              FontWeight="Light"
                              Foreground="{StaticResource TextSecondaryBrush}"
                              HorizontalAlignment="Center"/>
                    <TextBlock x:Name="BigTimeText"
                              Text="12:00"
                              FontSize="96"
                              FontWeight="Light"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              HorizontalAlignment="Center"
                              Margin="0,-10,0,0"/>
                </StackPanel>

                <!-- App Grid (4x3 layout for taller screen) -->
                <ItemsControl x:Name="AppGrid"
                             Grid.Row="1"
                             HorizontalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" Rows="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource AppTileStyle}"
                                   Width="200" Height="200"
                                   Margin="12"
                                   Click="AppTile_Click"
                                   Tag="{Binding AppPath}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Icon}"
                                              FontSize="64"
                                              HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}"
                                              FontSize="16"
                                              Foreground="{StaticResource TextSecondaryBrush}"
                                              HorizontalAlignment="Center"
                                              Margin="0,12,0,0"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Keyboard Shortcuts Info -->
                <Border Grid.Row="2"
                       Background="{StaticResource CardBrush}"
                       CornerRadius="12"
                       Padding="20"
                       Margin="0,40,0,20">
                    <StackPanel>
                        <TextBlock Text="Keyboard Shortcuts"
                                  FontSize="16"
                                  FontWeight="SemiBold"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="P - Phone" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="M - Messages" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="B - Browser" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="N - Maps" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="U - Music" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="C - Calendar" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="G - Gallery" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="S - Settings" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4"/>
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="1-9 - Quick launch apps" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="Esc - Exit app" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- Bottom Navigation -->
        <Border Grid.Row="2"
               Background="{StaticResource SurfaceBrush}"
               CornerRadius="24,24,0,0">
            <Grid Margin="60,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Phone Button -->
                <Button Grid.Column="0"
                       Style="{StaticResource AppTileStyle}"
                       Width="64" Height="64"
                       Click="PhoneButton_Click"
                       ToolTip="Phone (P)">
                    <TextBlock Text="&#128222;" FontSize="32"/>
                </Button>

                <!-- Home Button -->
                <Button Grid.Column="1"
                       Style="{StaticResource AppTileStyle}"
                       Width="64" Height="64"
                       Background="{StaticResource PrimaryBrush}"
                       Click="HomeButton_Click"
                       ToolTip="Home">
                    <Ellipse Width="18" Height="18" Fill="White"/>
                </Button>

                <!-- Messages Button -->
                <Button Grid.Column="2"
                       Style="{StaticResource AppTileStyle}"
                       Width="64" Height="64"
                       Click="MessagesButton_Click"
                       ToolTip="Messages (M)">
                    <TextBlock Text="&#128172;" FontSize="32"/>
                </Button>
            </Grid>
        </Border>

        <!-- Incoming Call Overlay -->
        <Border x:Name="IncomingCallOverlay"
               Grid.RowSpan="3"
               Background="#E0000000"
               Visibility="Collapsed">
            <Grid>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Incoming Call"
                              FontSize="24"
                              Foreground="{StaticResource TextSecondaryBrush}"
                              HorizontalAlignment="Center"
                              Margin="0,0,0,16"/>
                    <TextBlock x:Name="CallerIdText"
                              Text="+1 234 567 8900"
                              FontSize="36"
                              FontWeight="SemiBold"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              HorizontalAlignment="Center"
                              Margin="0,0,0,60"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Style="{StaticResource EndCallButtonStyle}"
                               Width="80" Height="80"
                               Margin="30,0"
                               Click="DeclineCall_Click">
                            <TextBlock Text="&#128222;" FontSize="32"
                                      RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <RotateTransform Angle="135"/>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Button>
                        <Button Style="{StaticResource CallButtonStyle}"
                               Width="80" Height="80"
                               Margin="30,0"
                               Click="AcceptCall_Click">
                            <TextBlock Text="&#128222;" FontSize="32"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
