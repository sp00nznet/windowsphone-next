<Window x:Class="WindowsPhoneNext.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Windows Phone"
        Width="720" Height="720"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Loaded="Window_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>

        <!-- Status Bar -->
        <Border Grid.Row="0" Style="{StaticResource StatusBarStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Time -->
                <TextBlock x:Name="TimeText"
                          Text="12:00"
                          FontSize="20"
                          FontWeight="SemiBold"
                          Foreground="{StaticResource TextPrimaryBrush}"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Left"
                          Margin="8,0,0,0"/>

                <!-- Status Icons -->
                <StackPanel Grid.Column="1"
                           Orientation="Horizontal"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0">

                    <!-- Signal Strength -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                        <TextBlock x:Name="SignalText"
                                  Text="Signal"
                                  FontSize="12"
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0"/>
                        <Grid Width="24" Height="16" VerticalAlignment="Center">
                            <Rectangle Width="4" Height="4" Fill="{StaticResource TextSecondaryBrush}"
                                      HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                            <Rectangle Width="4" Height="8" Fill="{StaticResource TextSecondaryBrush}"
                                      HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6,0,0,0"/>
                            <Rectangle x:Name="Signal3" Width="4" Height="12" Fill="{StaticResource TextSecondaryBrush}"
                                      HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12,0,0,0"/>
                            <Rectangle x:Name="Signal4" Width="4" Height="16" Fill="{StaticResource TextSecondaryBrush}"
                                      HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="18,0,0,0"/>
                        </Grid>
                    </StackPanel>

                    <!-- Network -->
                    <TextBlock x:Name="NetworkText"
                              Text="LTE"
                              FontSize="12"
                              FontWeight="Bold"
                              Foreground="{StaticResource TextSecondaryBrush}"
                              VerticalAlignment="Center"
                              Margin="0,0,16,0"/>

                    <!-- Battery -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="BatteryText"
                                  Text="100%"
                                  FontSize="12"
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0"/>
                        <Border Width="28" Height="14"
                               BorderBrush="{StaticResource TextSecondaryBrush}"
                               BorderThickness="1"
                               CornerRadius="2"
                               VerticalAlignment="Center">
                            <Rectangle x:Name="BatteryLevel"
                                      Fill="{StaticResource SuccessBrush}"
                                      Width="24"
                                      HorizontalAlignment="Left"
                                      Margin="1"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Date Display -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,20,0,40">
                <TextBlock x:Name="DateText"
                          Text="Monday, January 13"
                          FontSize="24"
                          FontWeight="Light"
                          Foreground="{StaticResource TextSecondaryBrush}"
                          HorizontalAlignment="Center"/>
                <TextBlock x:Name="BigTimeText"
                          Text="12:00"
                          FontSize="72"
                          FontWeight="Light"
                          Foreground="{StaticResource TextPrimaryBrush}"
                          HorizontalAlignment="Center"
                          Margin="0,-10,0,0"/>
            </StackPanel>

            <!-- App Grid -->
            <ItemsControl x:Name="AppGrid"
                         Grid.Row="1"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" Rows="3"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource AppTileStyle}"
                               Width="140" Height="140"
                               Margin="10"
                               Click="AppTile_Click"
                               Tag="{Binding AppPath}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Icon}"
                                          FontSize="48"
                                          HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding Name}"
                                          FontSize="14"
                                          Foreground="{StaticResource TextSecondaryBrush}"
                                          HorizontalAlignment="Center"
                                          Margin="0,8,0,0"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!-- Bottom Navigation -->
        <Border Grid.Row="2"
               Background="{StaticResource SurfaceBrush}"
               CornerRadius="24,24,0,0">
            <Grid Margin="40,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Phone Button -->
                <Button Grid.Column="0"
                       Style="{StaticResource AppTileStyle}"
                       Width="56" Height="56"
                       Click="PhoneButton_Click"
                       ToolTip="Phone">
                    <TextBlock Text="&#128222;" FontSize="28"/>
                </Button>

                <!-- Home Button -->
                <Button Grid.Column="1"
                       Style="{StaticResource AppTileStyle}"
                       Width="56" Height="56"
                       Background="{StaticResource PrimaryBrush}"
                       Click="HomeButton_Click"
                       ToolTip="Home">
                    <Ellipse Width="16" Height="16" Fill="White"/>
                </Button>

                <!-- Messages Button -->
                <Button Grid.Column="2"
                       Style="{StaticResource AppTileStyle}"
                       Width="56" Height="56"
                       Click="MessagesButton_Click"
                       ToolTip="Messages">
                    <TextBlock Text="&#128172;" FontSize="28"/>
                </Button>
            </Grid>
        </Border>

        <!-- Incoming Call Overlay -->
        <Border x:Name="IncomingCallOverlay"
               Grid.RowSpan="3"
               Background="#E0000000"
               Visibility="Collapsed">
            <Grid>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Incoming Call"
                              FontSize="24"
                              Foreground="{StaticResource TextSecondaryBrush}"
                              HorizontalAlignment="Center"
                              Margin="0,0,0,16"/>
                    <TextBlock x:Name="CallerIdText"
                              Text="+1 234 567 8900"
                              FontSize="36"
                              FontWeight="SemiBold"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              HorizontalAlignment="Center"
                              Margin="0,0,0,60"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Style="{StaticResource EndCallButtonStyle}"
                               Width="80" Height="80"
                               Margin="30,0"
                               Click="DeclineCall_Click">
                            <TextBlock Text="&#128222;" FontSize="32"
                                      RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <RotateTransform Angle="135"/>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Button>
                        <Button Style="{StaticResource CallButtonStyle}"
                               Width="80" Height="80"
                               Margin="30,0"
                               Click="AcceptCall_Click">
                            <TextBlock Text="&#128222;" FontSize="32"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
