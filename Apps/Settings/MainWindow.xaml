<Window x:Class="WindowsPhoneNext.Settings.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="720" Height="720"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Bar -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}">
            <Grid Margin="8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                       Style="{StaticResource BackButtonStyle}"
                       Click="BackButton_Click">
                    <TextBlock Text="&#x2190;" FontSize="24" Foreground="White"/>
                </Button>

                <TextBlock Grid.Column="1"
                          Text="Settings"
                          FontSize="20"
                          FontWeight="SemiBold"
                          Foreground="{StaticResource TextPrimaryBrush}"
                          VerticalAlignment="Center"
                          Margin="8,0,0,0"/>
            </Grid>
        </Border>

        <!-- Settings Content -->
        <ScrollViewer Grid.Row="1"
                     VerticalScrollBarVisibility="Auto"
                     Padding="20">
            <StackPanel>

                <!-- Apps Section -->
                <TextBlock Text="Apps"
                          FontSize="14"
                          FontWeight="SemiBold"
                          Foreground="{StaticResource TextSecondaryBrush}"
                          Margin="0,0,0,12"/>

                <!-- Gallery Settings -->
                <Border Style="{StaticResource SettingsItemStyle}">
                    <StackPanel>
                        <TextBlock Text="Gallery"
                                  FontSize="16"
                                  FontWeight="SemiBold"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  Margin="0,0,0,4"/>
                        <TextBlock Text="Image folder location"
                                  FontSize="12"
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  Margin="0,0,0,12"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="GalleryPathBox"
                                    Grid.Column="0"
                                    Style="{StaticResource TextInputStyle}"
                                    IsReadOnly="True"
                                    Margin="0,0,8,0"/>

                            <Button Grid.Column="1"
                                   Style="{StaticResource PrimaryButtonStyle}"
                                   Content="Browse"
                                   Click="BrowseGalleryPath_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Music Settings -->
                <Border Style="{StaticResource SettingsItemStyle}">
                    <StackPanel>
                        <TextBlock Text="Music"
                                  FontSize="16"
                                  FontWeight="SemiBold"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  Margin="0,0,0,4"/>
                        <TextBlock Text="Music folder location"
                                  FontSize="12"
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  Margin="0,0,0,12"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="MusicPathBox"
                                    Grid.Column="0"
                                    Style="{StaticResource TextInputStyle}"
                                    IsReadOnly="True"
                                    Margin="0,0,8,0"/>

                            <Button Grid.Column="1"
                                   Style="{StaticResource PrimaryButtonStyle}"
                                   Content="Browse"
                                   Click="BrowseMusicPath_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- System Section -->
                <TextBlock Text="System"
                          FontSize="14"
                          FontWeight="SemiBold"
                          Foreground="{StaticResource TextSecondaryBrush}"
                          Margin="0,20,0,12"/>

                <!-- About -->
                <Border Style="{StaticResource SettingsItemStyle}">
                    <StackPanel>
                        <TextBlock Text="About"
                                  FontSize="16"
                                  FontWeight="SemiBold"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  Margin="0,0,0,8"/>

                        <TextBlock Text="Windows Phone Next"
                                  FontSize="14"
                                  Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="Version 1.0.0"
                                  FontSize="12"
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Storage Info -->
                <Border Style="{StaticResource SettingsItemStyle}">
                    <StackPanel>
                        <TextBlock Text="Storage"
                                  FontSize="16"
                                  FontWeight="SemiBold"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  Margin="0,0,0,8"/>

                        <TextBlock x:Name="StorageInfoText"
                                  Text="Loading..."
                                  FontSize="14"
                                  Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
