<Window x:Class="WindowsPhoneNext.Settings.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="720" Height="1560"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        KeyDown="Window_KeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Bar -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                       Style="{StaticResource BackButtonStyle}"
                       Click="BackButton_Click">
                    <TextBlock Text="&#x2190;" FontSize="24" Foreground="White"/>
                </Button>

                <TextBlock Grid.Column="1"
                          Text="Settings"
                          FontSize="20"
                          FontWeight="SemiBold"
                          Foreground="{StaticResource TextPrimaryBrush}"
                          VerticalAlignment="Center"
                          Margin="8,0,0,0"/>
            </Grid>
        </Border>

        <!-- Settings Content -->
        <ScrollViewer Grid.Row="1"
                     VerticalScrollBarVisibility="Auto"
                     Padding="20">
            <StackPanel>

                <!-- Display Section -->
                <TextBlock Text="Display"
                          FontSize="14"
                          FontWeight="SemiBold"
                          Foreground="{StaticResource TextSecondaryBrush}"
                          Margin="0,0,0,12"/>

                <!-- Display Info -->
                <Border Style="{StaticResource SettingsItemStyle}">
                    <StackPanel>
                        <TextBlock Text="Screen"
                                  FontSize="16"
                                  FontWeight="SemiBold"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  Margin="0,0,0,8"/>
                        <TextBlock Text="Waveshare 6.25&quot; LCD"
                                  FontSize="14"
                                  Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="720 x 1560 pixels"
                                  FontSize="12"
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- System Section -->
                <TextBlock Text="System"
                          FontSize="14"
                          FontWeight="SemiBold"
                          Foreground="{StaticResource TextSecondaryBrush}"
                          Margin="0,20,0,12"/>

                <!-- About -->
                <Border Style="{StaticResource SettingsItemStyle}">
                    <StackPanel>
                        <TextBlock Text="About"
                                  FontSize="16"
                                  FontWeight="SemiBold"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  Margin="0,0,0,8"/>

                        <TextBlock Text="Windows Phone Next"
                                  FontSize="14"
                                  Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="Version 1.0.0"
                                  FontSize="12"
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Storage Info -->
                <Border Style="{StaticResource SettingsItemStyle}">
                    <StackPanel>
                        <TextBlock Text="Storage"
                                  FontSize="16"
                                  FontWeight="SemiBold"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  Margin="0,0,0,8"/>

                        <TextBlock x:Name="StorageInfoText"
                                  Text="Loading..."
                                  FontSize="14"
                                  Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
