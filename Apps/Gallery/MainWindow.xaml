<Window x:Class="WindowsPhoneNext.Gallery.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gallery"
        Width="720" Height="1560"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Loaded="Window_Loaded"
        KeyDown="Window_KeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="140"/>
        </Grid.RowDefinitions>

        <!-- Top Bar -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Back Button -->
                <Button Grid.Column="0"
                       Style="{StaticResource NavButtonStyle}"
                       Width="44" Height="44"
                       Click="BackButton_Click">
                    <TextBlock Text="&#x2190;" FontSize="22"/>
                </Button>

                <!-- Title / Image Info -->
                <StackPanel Grid.Column="1"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText"
                              Text="Gallery"
                              FontSize="18"
                              FontWeight="SemiBold"
                              HorizontalAlignment="Center"
                              Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="ImageCountText"
                              Text="0 images"
                              FontSize="12"
                              HorizontalAlignment="Center"
                              Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>

                <!-- Open Folder Button -->
                <Button Grid.Column="2"
                       Style="{StaticResource NavButtonStyle}"
                       Width="44" Height="44"
                       Click="OpenFolder_Click"
                       ToolTip="Open Folder">
                    <TextBlock Text="&#x1F4C1;" FontSize="20"/>
                </Button>

                <!-- Settings Button -->
                <Button Grid.Column="3"
                       Style="{StaticResource NavButtonStyle}"
                       Width="44" Height="44"
                       Click="SettingsButton_Click"
                       ToolTip="Settings">
                    <TextBlock Text="&#x2699;" FontSize="20"/>
                </Button>
            </Grid>
        </Border>

        <!-- Main Image Area -->
        <Grid Grid.Row="1" Background="Black">
            <!-- Image Display -->
            <Image x:Name="MainImage"
                  Stretch="Uniform"
                  RenderOptions.BitmapScalingMode="HighQuality"/>

            <!-- No Images Message -->
            <StackPanel x:Name="NoImagesPanel"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="Visible">
                <TextBlock Text="&#x1F5BC;"
                          FontSize="64"
                          HorizontalAlignment="Center"
                          Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock Text="No images"
                          FontSize="18"
                          HorizontalAlignment="Center"
                          Foreground="{StaticResource TextSecondaryBrush}"
                          Margin="0,8,0,0"/>
                <TextBlock Text="Open a folder to view images"
                          FontSize="12"
                          HorizontalAlignment="Center"
                          Foreground="{StaticResource TextSecondaryBrush}"
                          Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Navigation Arrows (on hover) -->
            <Button x:Name="PrevButton"
                   Style="{StaticResource ControlButtonStyle}"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"
                   Margin="16,0,0,0"
                   Visibility="Collapsed"
                   Click="PrevImage_Click">
                <TextBlock Text="&#x25C0;" FontSize="20"/>
            </Button>

            <Button x:Name="NextButton"
                   Style="{StaticResource ControlButtonStyle}"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   Margin="0,0,16,0"
                   Visibility="Collapsed"
                   Click="NextImage_Click">
                <TextBlock Text="&#x25B6;" FontSize="20"/>
            </Button>

            <!-- Image Info Overlay -->
            <Border x:Name="ImageInfoOverlay"
                   VerticalAlignment="Bottom"
                   HorizontalAlignment="Stretch"
                   Background="#80000000"
                   Padding="16,8"
                   Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="ImageFileName"
                                  Text=""
                                  FontSize="14"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="ImageDetails"
                                  Text=""
                                  FontSize="11"
                                  Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>

                    <TextBlock x:Name="ImageIndex"
                              Grid.Column="1"
                              Text="1 / 10"
                              FontSize="14"
                              Foreground="{StaticResource TextSecondaryBrush}"
                              VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Thumbnail Strip -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}">
            <ScrollViewer x:Name="ThumbnailScroller"
                         HorizontalScrollBarVisibility="Auto"
                         VerticalScrollBarVisibility="Disabled"
                         Margin="8">
                <StackPanel x:Name="ThumbnailPanel"
                           Orientation="Horizontal"/>
            </ScrollViewer>
        </Border>

        <!-- Settings Overlay -->
        <Border x:Name="SettingsOverlay"
               Grid.RowSpan="3"
               Background="#E0000000"
               Visibility="Collapsed"
               Panel.ZIndex="200">
            <Border Background="{StaticResource SurfaceBrush}"
                   CornerRadius="16"
                   Margin="40"
                   Padding="24"
                   VerticalAlignment="Center"
                   MaxHeight="500">
                <StackPanel>
                    <Grid Margin="0,0,0,20">
                        <TextBlock Text="Gallery Settings"
                                  FontSize="20"
                                  FontWeight="SemiBold"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  HorizontalAlignment="Left"/>
                        <Button Content="&#x2715;"
                               HorizontalAlignment="Right"
                               Background="Transparent"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               BorderThickness="0"
                               FontSize="20"
                               Cursor="Hand"
                               Click="CloseSettings_Click"/>
                    </Grid>

                    <!-- Default Folder Setting -->
                    <Border Background="{StaticResource CardBrush}"
                           CornerRadius="8"
                           Padding="16"
                           Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Default Image Folder"
                                      FontSize="16"
                                      FontWeight="SemiBold"
                                      Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Set a folder to load on startup"
                                      FontSize="12"
                                      Foreground="{StaticResource TextSecondaryBrush}"
                                      Margin="0,4,0,12"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="DefaultPathBox"
                                        Grid.Column="0"
                                        IsReadOnly="True"
                                        Background="{StaticResource BackgroundBrush}"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        BorderThickness="0"
                                        Padding="12,8"
                                        FontSize="12"
                                        Margin="0,0,8,0"/>
                                <Button Grid.Column="1"
                                       Content="Browse"
                                       Background="{StaticResource PrimaryBrush}"
                                       Foreground="White"
                                       BorderThickness="0"
                                       Padding="16,8"
                                       Cursor="Hand"
                                       Click="BrowseDefaultPath_Click"/>
                            </Grid>
                            <Button Content="Clear Default"
                                   Background="Transparent"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   BorderThickness="0"
                                   HorizontalAlignment="Left"
                                   Margin="0,8,0,0"
                                   Cursor="Hand"
                                   Click="ClearDefaultPath_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
