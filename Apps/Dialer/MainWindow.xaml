<Window x:Class="WindowsPhoneNext.Dialer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Phone"
        Width="720" Height="1560"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Loaded="Window_Loaded"
        KeyDown="Window_KeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Bar -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}">
            <Grid Margin="16,0">
                <Button Content="&#x2190;"
                       HorizontalAlignment="Left"
                       Background="Transparent"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       BorderThickness="0"
                       FontSize="24"
                       Cursor="Hand"
                       Click="BackButton_Click"/>
                <TextBlock Text="Phone"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          FontSize="18"
                          FontWeight="SemiBold"
                          Foreground="{StaticResource TextPrimaryBrush}"/>
            </Grid>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1">
            <!-- Dialpad View -->
            <Grid x:Name="DialpadView">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="80"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="100"/>
                </Grid.RowDefinitions>

                <!-- Tabs -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button x:Name="KeypadTab" Content="Keypad" Style="{StaticResource TabButtonStyle}"
                           Foreground="{StaticResource PrimaryBrush}" Click="KeypadTab_Click"/>
                    <Button x:Name="RecentsTab" Content="Recents" Style="{StaticResource TabButtonStyle}"
                           Click="RecentsTab_Click"/>
                    <Button x:Name="ContactsTab" Content="Contacts" Style="{StaticResource TabButtonStyle}"
                           Click="ContactsTab_Click"/>
                </StackPanel>

                <!-- Phone Number Display -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="20,0">
                    <TextBlock x:Name="PhoneNumberDisplay"
                              Text=""
                              FontSize="32"
                              FontWeight="Light"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              HorizontalAlignment="Center"
                              TextWrapping="NoWrap"/>
                    <TextBlock x:Name="ContactNameDisplay"
                              Text=""
                              FontSize="12"
                              Foreground="{StaticResource TextSecondaryBrush}"
                              HorizontalAlignment="Center"
                              Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Dialpad Grid -->
                <Grid x:Name="DialpadGrid" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Row 1 -->
                    <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource DialpadButtonStyle}"
                           Content="1" Margin="8" Click="DialpadButton_Click" Tag="1"/>
                    <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource DialpadButtonStyle}"
                           Content="2" Margin="8" Click="DialpadButton_Click" Tag="2"/>
                    <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource DialpadButtonStyle}"
                           Content="3" Margin="8" Click="DialpadButton_Click" Tag="3"/>

                    <!-- Row 2 -->
                    <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource DialpadButtonStyle}"
                           Content="4" Margin="8" Click="DialpadButton_Click" Tag="4"/>
                    <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource DialpadButtonStyle}"
                           Content="5" Margin="8" Click="DialpadButton_Click" Tag="5"/>
                    <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource DialpadButtonStyle}"
                           Content="6" Margin="8" Click="DialpadButton_Click" Tag="6"/>

                    <!-- Row 3 -->
                    <Button Grid.Row="2" Grid.Column="0" Style="{StaticResource DialpadButtonStyle}"
                           Content="7" Margin="8" Click="DialpadButton_Click" Tag="7"/>
                    <Button Grid.Row="2" Grid.Column="1" Style="{StaticResource DialpadButtonStyle}"
                           Content="8" Margin="8" Click="DialpadButton_Click" Tag="8"/>
                    <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource DialpadButtonStyle}"
                           Content="9" Margin="8" Click="DialpadButton_Click" Tag="9"/>

                    <!-- Row 4 -->
                    <Button Grid.Row="3" Grid.Column="0" Style="{StaticResource DialpadButtonStyle}"
                           Content="*" Margin="8" Click="DialpadButton_Click" Tag="*"/>
                    <Button Grid.Row="3" Grid.Column="1" Style="{StaticResource DialpadButtonStyle}"
                           Content="0" Margin="8" Click="DialpadButton_Click" Tag="0"
                           MouseRightButtonDown="ZeroButton_Hold"/>
                    <Button Grid.Row="3" Grid.Column="2" Style="{StaticResource DialpadButtonStyle}"
                           Content="#" Margin="8" Click="DialpadButton_Click" Tag="#"/>
                </Grid>

                <!-- Recents List (hidden by default) -->
                <ListView x:Name="RecentsList" Grid.Row="2"
                         Visibility="Collapsed"
                         Background="Transparent"
                         BorderThickness="0"
                         Margin="20">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Ellipse Grid.Column="0" Width="40" Height="40" Fill="{StaticResource CardBrush}"/>

                                <StackPanel Grid.Column="1" Margin="12,0">
                                    <TextBlock Text="{Binding PhoneNumber}"
                                              FontSize="16"
                                              Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding CallType}"
                                              FontSize="12"
                                              Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>

                                <TextBlock Grid.Column="2"
                                          Text="{Binding Time}"
                                          FontSize="12"
                                          Foreground="{StaticResource TextSecondaryBrush}"
                                          VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Call/Delete Buttons -->
                <Grid Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"/>

                    <Button Grid.Column="1" Style="{StaticResource CallButtonStyle}"
                           Click="CallButton_Click">
                        <TextBlock Text="&#128222;" FontSize="28"/>
                    </Button>

                    <Button x:Name="DeleteButton" Grid.Column="2"
                           Style="{StaticResource ActionButtonStyle}"
                           Click="DeleteButton_Click"
                           Visibility="Collapsed">
                        <TextBlock Text="&#9003;" FontSize="20"/>
                    </Button>
                </Grid>
            </Grid>

            <!-- Active Call View (hidden by default) -->
            <Grid x:Name="ActiveCallView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="160"/>
                </Grid.RowDefinitions>

                <!-- Caller Info -->
                <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Ellipse Width="100" Height="100" Fill="{StaticResource CardBrush}" Margin="0,0,0,20"/>
                    <TextBlock x:Name="ActiveCallNumber"
                              Text="+1 234 567 8900"
                              FontSize="28"
                              FontWeight="SemiBold"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              HorizontalAlignment="Center"/>
                    <TextBlock x:Name="CallStatusText"
                              Text="Calling..."
                              FontSize="16"
                              Foreground="{StaticResource TextSecondaryBrush}"
                              HorizontalAlignment="Center"
                              Margin="0,8,0,0"/>
                    <TextBlock x:Name="CallDurationText"
                              Text="00:00"
                              FontSize="20"
                              Foreground="{StaticResource TextSecondaryBrush}"
                              HorizontalAlignment="Center"
                              Margin="0,12,0,0"/>
                </StackPanel>

                <!-- In-call Actions -->
                <Grid Grid.Row="1" HorizontalAlignment="Center" Margin="0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Style="{StaticResource ActionButtonStyle}"
                           Margin="16,0" Click="MuteButton_Click">
                        <StackPanel>
                            <TextBlock x:Name="MuteIcon" Text="&#128263;" FontSize="20" HorizontalAlignment="Center"/>
                            <TextBlock Text="Mute" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}"
                                      HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="1" Style="{StaticResource ActionButtonStyle}"
                           Margin="16,0" Click="SpeakerButton_Click">
                        <StackPanel>
                            <TextBlock x:Name="SpeakerIcon" Text="&#128266;" FontSize="20" HorizontalAlignment="Center"/>
                            <TextBlock Text="Speaker" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}"
                                      HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="2" Style="{StaticResource ActionButtonStyle}"
                           Margin="16,0" Click="KeypadButton_Click">
                        <StackPanel>
                            <TextBlock Text="&#128290;" FontSize="20" HorizontalAlignment="Center"/>
                            <TextBlock Text="Keypad" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}"
                                      HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- End Call Button -->
                <Grid Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Style="{StaticResource EndCallButtonStyle}"
                           Width="80" Height="80"
                           Click="EndCallButton_Click">
                        <TextBlock Text="&#128222;" FontSize="32"
                                  RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <RotateTransform Angle="135"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Button>
                </Grid>
            </Grid>

            <!-- In-call Dialpad Overlay -->
            <Border x:Name="InCallDialpadOverlay"
                   Background="#F0000000"
                   Visibility="Collapsed">
                <Grid>
                    <Button Content="&#x2715;"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Top"
                           Background="Transparent"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           BorderThickness="0"
                           FontSize="24"
                           Margin="20"
                           Cursor="Hand"
                           Click="CloseInCallDialpad_Click"/>

                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource DialpadButtonStyle}"
                               Content="1" Margin="8" Click="DtmfButton_Click" Tag="1"/>
                        <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource DialpadButtonStyle}"
                               Content="2" Margin="8" Click="DtmfButton_Click" Tag="2"/>
                        <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource DialpadButtonStyle}"
                               Content="3" Margin="8" Click="DtmfButton_Click" Tag="3"/>
                        <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource DialpadButtonStyle}"
                               Content="4" Margin="8" Click="DtmfButton_Click" Tag="4"/>
                        <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource DialpadButtonStyle}"
                               Content="5" Margin="8" Click="DtmfButton_Click" Tag="5"/>
                        <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource DialpadButtonStyle}"
                               Content="6" Margin="8" Click="DtmfButton_Click" Tag="6"/>
                        <Button Grid.Row="2" Grid.Column="0" Style="{StaticResource DialpadButtonStyle}"
                               Content="7" Margin="8" Click="DtmfButton_Click" Tag="7"/>
                        <Button Grid.Row="2" Grid.Column="1" Style="{StaticResource DialpadButtonStyle}"
                               Content="8" Margin="8" Click="DtmfButton_Click" Tag="8"/>
                        <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource DialpadButtonStyle}"
                               Content="9" Margin="8" Click="DtmfButton_Click" Tag="9"/>
                        <Button Grid.Row="3" Grid.Column="0" Style="{StaticResource DialpadButtonStyle}"
                               Content="*" Margin="8" Click="DtmfButton_Click" Tag="*"/>
                        <Button Grid.Row="3" Grid.Column="1" Style="{StaticResource DialpadButtonStyle}"
                               Content="0" Margin="8" Click="DtmfButton_Click" Tag="0"/>
                        <Button Grid.Row="3" Grid.Column="2" Style="{StaticResource DialpadButtonStyle}"
                               Content="#" Margin="8" Click="DtmfButton_Click" Tag="#"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
