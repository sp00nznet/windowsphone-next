<Window x:Class="WindowsPhoneNext.Terminal.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Terminal"
        Width="720" Height="1560"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{StaticResource TerminalBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource HeaderBackgroundBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Back Button -->
                <Button Grid.Column="0"
                        Style="{StaticResource HeaderButtonStyle}"
                        Click="BackButton_Click"
                        ToolTip="Close Terminal">
                    <TextBlock Text="&#x2190;" FontSize="24"/>
                </Button>

                <!-- Title -->
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#x1F427;" FontSize="24" Margin="0,0,10,0"/>
                    <TextBlock x:Name="TitleText" Text="Ubuntu"
                               FontSize="20" FontWeight="SemiBold" Foreground="White"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Menu Button -->
                <Button Grid.Column="2"
                        Style="{StaticResource HeaderButtonStyle}"
                        Click="MenuButton_Click"
                        ToolTip="Switch Distribution">
                    <TextBlock Text="&#x2630;" FontSize="20"/>
                </Button>
            </Grid>
        </Border>

        <!-- Terminal Output -->
        <ScrollViewer Grid.Row="1" x:Name="OutputScrollViewer"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Background="{StaticResource TerminalBackgroundBrush}">
            <TextBlock x:Name="OutputText"
                       FontFamily="Cascadia Mono, Consolas, Courier New"
                       FontSize="14"
                       Foreground="{StaticResource TerminalForegroundBrush}"
                       TextWrapping="Wrap"
                       Padding="10"
                       IsHitTestVisible="True"
                       MouseLeftButtonDown="OutputText_MouseLeftButtonDown"/>
        </ScrollViewer>

        <!-- Input Area -->
        <Border Grid.Row="2" Background="{StaticResource HeaderBackgroundBrush}" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Prompt -->
                <TextBlock Grid.Column="0"
                           x:Name="PromptText"
                           Text="$"
                           FontFamily="Cascadia Mono, Consolas, Courier New"
                           FontSize="16"
                           Foreground="{StaticResource TerminalPromptBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>

                <!-- Input TextBox -->
                <TextBox Grid.Column="1"
                         x:Name="InputTextBox"
                         FontFamily="Cascadia Mono, Consolas, Courier New"
                         FontSize="16"
                         Background="Transparent"
                         Foreground="White"
                         CaretBrush="White"
                         BorderThickness="0"
                         VerticalAlignment="Center"
                         KeyDown="InputTextBox_KeyDown"/>

                <!-- Send Button -->
                <Button Grid.Column="2"
                        Style="{StaticResource HeaderButtonStyle}"
                        Click="SendButton_Click"
                        ToolTip="Send Command">
                    <TextBlock Text="&#x27A4;" FontSize="20"/>
                </Button>
            </Grid>
        </Border>

        <!-- Distro Selection Overlay -->
        <Border x:Name="DistroOverlay" Grid.RowSpan="3"
                Background="#E0000000" Visibility="Collapsed">
            <Border Background="{StaticResource TerminalBackgroundBrush}"
                    CornerRadius="16"
                    Margin="40"
                    Padding="20"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Select Distribution"
                               FontSize="24" FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20"/>

                    <ItemsControl x:Name="DistroList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <Button Content="Cancel"
                            Style="{StaticResource HeaderButtonStyle}"
                            Click="CancelDistroSelection_Click"
                            HorizontalAlignment="Center"
                            Margin="0,20,0,0"/>
                </StackPanel>
            </Border>
        </Border>

        <!-- Not Installed Overlay -->
        <Border x:Name="NotInstalledOverlay" Grid.RowSpan="3"
                Background="{StaticResource TerminalBackgroundBrush}" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="&#x1F427;" FontSize="80" HorizontalAlignment="Center"/>
                <TextBlock Text="WSL Not Installed"
                           FontSize="28" FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Margin="0,20,0,10"/>
                <TextBlock Text="Windows Subsystem for Linux is not available."
                           FontSize="16"
                           Foreground="#9CA3AF"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="400"
                           TextAlignment="Center"/>
                <TextBlock Text="Run Setup\Remove-Bloatware.ps1 to install WSL and Ubuntu."
                           FontSize="14"
                           Foreground="#9CA3AF"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="400"
                           TextAlignment="Center"
                           Margin="0,10,0,20"/>
                <Button Content="Close"
                        Style="{StaticResource DistroButtonStyle}"
                        Click="BackButton_Click"
                        HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
