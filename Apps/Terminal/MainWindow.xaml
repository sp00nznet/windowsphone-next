<Window x:Class="WindowsPhoneNext.Terminal.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Terminal"
        Width="720" Height="1560"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        KeyDown="Window_KeyDown">

    <!-- Bezel-safe container with curved corners -->
    <Border Style="{StaticResource BezelWindowBorderStyle}"
            Background="{StaticResource BackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>      <!-- Header -->
                <RowDefinition Height="60"/>      <!-- Tab Bar -->
                <RowDefinition Height="*"/>       <!-- Terminal Content -->
                <RowDefinition Height="80"/>      <!-- Input Area -->
                <RowDefinition Height="100"/>     <!-- Bottom Navigation -->
            </Grid.RowDefinitions>

            <!-- Header with bezel-safe margins -->
            <Border Grid.Row="0" Style="{StaticResource BezelStatusBarStyle}" Background="{StaticResource SurfaceBrush}">
            <Grid>
                <TextBlock Text="Terminal"
                           FontSize="{StaticResource FontSizeXLarge}"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="ClearButton"
                            Content="Clear"
                            Style="{StaticResource TabButtonStyle}"
                            Click="ClearButton_Click"
                            Padding="12,8"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tab Bar -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}">
            <StackPanel Orientation="Horizontal" Margin="12,0">
                <Button x:Name="CmdTab"
                        Content="CMD"
                        Tag="cmd"
                        Style="{StaticResource ActiveTabButtonStyle}"
                        Click="Tab_Click"/>
                <Button x:Name="PowerShellTab"
                        Content="PowerShell"
                        Tag="powershell"
                        Style="{StaticResource TabButtonStyle}"
                        Click="Tab_Click"/>
                <Button x:Name="WslTab"
                        Content="WSL"
                        Tag="wsl"
                        Style="{StaticResource TabButtonStyle}"
                        Click="Tab_Click"/>
            </StackPanel>
        </Border>

        <!-- Terminal Output Area -->
        <Border Grid.Row="2" Margin="12,8" CornerRadius="12">
            <Border.Background>
                <SolidColorBrush x:Name="TerminalBackground" Color="#1E1E1E"/>
            </Border.Background>
            <ScrollViewer x:Name="OutputScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="16">
                <TextBlock x:Name="OutputText"
                           FontFamily="Cascadia Mono, Consolas, Courier New"
                           FontSize="{StaticResource FontSizeTerminal}"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           TextWrapping="Wrap"
                           Text=""/>
            </ScrollViewer>
        </Border>

        <!-- Command Input Area -->
        <Border Grid.Row="3" Margin="12,4" Background="{StaticResource CardBrush}" CornerRadius="12" Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="PromptText"
                           Grid.Column="0"
                           Text="C:\&gt; "
                           FontFamily="Cascadia Mono, Consolas, Courier New"
                           FontSize="{StaticResource FontSizeTerminal}"
                           Foreground="{StaticResource AccentBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>

                <TextBox x:Name="CommandInput"
                         Grid.Column="1"
                         Style="{StaticResource CommandInputStyle}"
                         KeyDown="CommandInput_KeyDown"
                         VerticalAlignment="Center"/>

                <Button Grid.Column="2"
                        Content=">"
                        Style="{StaticResource ActionButtonStyle}"
                        Width="48"
                        Height="48"
                        FontSize="20"
                        FontWeight="Bold"
                        Click="ExecuteButton_Click"
                        Margin="8,0,0,0"/>
            </Grid>
        </Border>

            <!-- Bottom Navigation with bezel-safe margins -->
            <Border Grid.Row="4" Style="{StaticResource BezelBottomNavStyle}" Background="{StaticResource SurfaceBrush}">
            <Grid Margin="40,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        x:Name="HistoryButton"
                        Style="{StaticResource ActionButtonStyle}"
                        Click="HistoryButton_Click"
                        HorizontalAlignment="Center"
                        ToolTip="Command History (Up/Down)">
                    <TextBlock Text="H" FontSize="20" FontWeight="Bold"/>
                </Button>

                <Button Grid.Column="1"
                        x:Name="HomeButton"
                        Style="{StaticResource ActionButtonStyle}"
                        Click="HomeButton_Click"
                        HorizontalAlignment="Center"
                        ToolTip="Home">
                    <TextBlock Text="O" FontSize="28"/>
                </Button>

                <Button Grid.Column="2"
                        x:Name="KillButton"
                        Style="{StaticResource ActionButtonStyle}"
                        Click="KillButton_Click"
                        HorizontalAlignment="Center"
                        Background="{StaticResource ErrorBrush}"
                        ToolTip="Kill Process (Ctrl+C)">
                    <TextBlock Text="X" FontSize="20" FontWeight="Bold"/>
                </Button>
            </Grid>
        </Border>
        </Grid>
    </Border>
</Window>
