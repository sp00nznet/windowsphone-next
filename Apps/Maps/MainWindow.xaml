<Window x:Class="WindowsPhoneNext.Maps.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Maps"
        Width="720" Height="1560"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Loaded="Window_Loaded"
        KeyDown="Window_KeyDown">

    <!-- Bezel-safe container with curved corners -->
    <Border Style="{StaticResource BezelWindowBorderStyle}"
            Background="{StaticResource BackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Bar with Search and bezel-safe margins -->
            <Border Grid.Row="0"
                   Style="{StaticResource BezelStatusBarStyle}"
                   Background="{StaticResource SurfaceBrush}"
                   Panel.ZIndex="100">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Back Button -->
                <Button Grid.Column="0"
                       Style="{StaticResource MapButtonStyle}"
                       Width="44" Height="44"
                       Margin="0,0,8,0"
                       Click="BackButton_Click">
                    <TextBlock Text="&#x2190;" FontSize="22" Foreground="White"/>
                </Button>

                <!-- Search / Route Toggle -->
                <Grid Grid.Column="1">
                    <!-- Single Search Mode -->
                    <TextBox x:Name="SearchBox"
                            Text=""
                            KeyDown="SearchBox_KeyDown"
                            Visibility="Visible">
                        <TextBox.Resources>
                            <VisualBrush x:Key="HintBrush" AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                <VisualBrush.Visual>
                                    <TextBlock Text="Search location..." Foreground="#6B7280" Margin="12,0,0,0"/>
                                </VisualBrush.Visual>
                            </VisualBrush>
                        </TextBox.Resources>
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource SearchBoxStyle}">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Background" Value="{StaticResource HintBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <!-- Route Mode (A->B) -->
                    <Grid x:Name="RoutePanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBox x:Name="FromBox"
                                Grid.Row="0"
                                Style="{StaticResource SearchBoxStyle}"
                                Margin="0,0,0,4"
                                Tag="From"/>

                        <TextBox x:Name="ToBox"
                                Grid.Row="1"
                                Style="{StaticResource SearchBoxStyle}"
                                Tag="To"/>
                    </Grid>
                </Grid>

                <!-- Route Toggle Button -->
                <Button x:Name="RouteToggleButton"
                       Grid.Column="2"
                       Style="{StaticResource MapButtonStyle}"
                       Width="44" Height="44"
                       Margin="8,0,0,0"
                       Click="RouteToggleButton_Click"
                       ToolTip="Navigation">
                    <TextBlock Text="&#x27A4;" FontSize="20" Foreground="White"/>
                </Button>

                <!-- Settings Button -->
                <Button Grid.Column="3"
                       Style="{StaticResource MapButtonStyle}"
                       Width="44" Height="44"
                       Margin="8,0,0,0"
                       Click="SettingsButton_Click"
                       ToolTip="Settings">
                    <TextBlock Text="&#x2699;" FontSize="20" Foreground="White"/>
                </Button>
            </Grid>
        </Border>

            <!-- Map Area with bezel-safe margins -->
            <Grid Grid.Row="1" Margin="0,0,0,16">
            <!-- Map WebView -->
            <wv2:WebView2 x:Name="MapView"
                         Source="about:blank"
                         Focusable="False"/>

            <!-- Route Info Panel (shown when navigating) -->
            <Border x:Name="RouteInfoPanel"
                   VerticalAlignment="Top"
                   Margin="12"
                   Background="{StaticResource SurfaceBrush}"
                   CornerRadius="8"
                   Padding="16,12"
                   Visibility="Collapsed"
                   Panel.ZIndex="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="RouteDistanceText"
                                  Text="-- km"
                                  FontSize="20"
                                  FontWeight="Bold"
                                  Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="RouteDurationText"
                                  Text="-- min"
                                  FontSize="14"
                                  Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                           Style="{StaticResource RouteButtonStyle}"
                           Content="Start"
                           Click="StartNavigation_Click"/>
                </Grid>
            </Border>

            <!-- Bottom Controls -->
            <StackPanel VerticalAlignment="Bottom"
                       HorizontalAlignment="Right"
                       Margin="16"
                       Orientation="Vertical"
                       Panel.ZIndex="10">

                <!-- GPS Status Indicator -->
                <Border x:Name="GpsStatusBorder"
                       Background="{StaticResource SurfaceBrush}"
                       CornerRadius="20"
                       Padding="12,8"
                       Margin="0,0,0,8"
                       HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="GpsIndicator"
                                Width="10" Height="10"
                                Fill="#F44336"
                                Margin="0,0,8,0"/>
                        <TextBlock x:Name="GpsStatusText"
                                  Text="GPS: Searching..."
                                  FontSize="12"
                                  Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Zoom Controls -->
                <Button Style="{StaticResource MapButtonStyle}"
                       Margin="0,0,0,8"
                       Click="ZoomIn_Click">
                    <TextBlock Text="+" FontSize="24" FontWeight="Bold" Foreground="White"/>
                </Button>

                <Button Style="{StaticResource MapButtonStyle}"
                       Margin="0,0,0,8"
                       Click="ZoomOut_Click">
                    <TextBlock Text="-" FontSize="24" FontWeight="Bold" Foreground="White"/>
                </Button>

                <!-- My Location Button -->
                <Button Style="{StaticResource MapButtonStyle}"
                       Click="MyLocation_Click">
                    <TextBlock Text="&#x25CE;" FontSize="20" Foreground="White"/>
                </Button>
            </StackPanel>

            <!-- Route Button (shown when in route mode) -->
            <Button x:Name="GetRouteButton"
                   Style="{StaticResource RouteButtonStyle}"
                   Content="Get Directions"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   Margin="0,0,0,16"
                   Visibility="Collapsed"
                   Panel.ZIndex="10"
                   Click="GetRoute_Click"/>

            <!-- Loading Overlay -->
            <Border x:Name="LoadingOverlay"
                   Background="#CC1A1A2E"
                   Visibility="Collapsed"
                   Panel.ZIndex="20">
                <StackPanel HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                    <TextBlock Text="Loading..."
                              FontSize="18"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Settings Overlay -->
        <Border x:Name="SettingsOverlay"
               Grid.RowSpan="2"
               Background="#E0000000"
               Visibility="Collapsed"
               Panel.ZIndex="200">
            <Border Background="{StaticResource SurfaceBrush}"
                   CornerRadius="16"
                   Margin="40"
                   Padding="24"
                   VerticalAlignment="Center"
                   MaxHeight="400">
                <StackPanel>
                    <Grid Margin="0,0,0,20">
                        <TextBlock Text="Maps Settings"
                                  FontSize="20"
                                  FontWeight="SemiBold"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  HorizontalAlignment="Left"/>
                        <Button Content="&#x2715;"
                               HorizontalAlignment="Right"
                               Background="Transparent"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               BorderThickness="0"
                               FontSize="20"
                               Cursor="Hand"
                               Click="CloseSettings_Click"/>
                    </Grid>

                    <!-- Demo Mode Toggle -->
                    <Border Background="{StaticResource CardBrush}"
                           CornerRadius="8"
                           Padding="16"
                           Margin="0,0,0,12">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Demo Mode"
                                          FontSize="16"
                                          FontWeight="SemiBold"
                                          Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Simulate GPS movement without hardware"
                                          FontSize="12"
                                          Foreground="{StaticResource TextSecondaryBrush}"
                                          Margin="0,4,0,0"/>
                            </StackPanel>
                            <CheckBox x:Name="DemoModeToggle"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Center"
                                     Click="DemoModeToggle_Click"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </Border>
        </Grid>
    </Border>
</Window>
