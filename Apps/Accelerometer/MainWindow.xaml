<Window x:Class="WindowsPhoneNext.Accelerometer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Accelerometer"
        Width="720" Height="1560"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0F0F1A">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Style="{StaticResource HeaderButtonStyle}"
                        Click="BackButton_Click">
                    <TextBlock Text="&#x2190;" FontSize="24"/>
                </Button>

                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#x1F4F1;" FontSize="24" Margin="0,0,10,0"/>
                    <TextBlock Text="Accelerometer"
                               FontSize="20" FontWeight="SemiBold" Foreground="White"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Ellipse x:Name="StatusIndicator" Width="12" Height="12"
                             Fill="#FF4444" Margin="0,0,10,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10">

                <!-- Sensor Info Card -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="BIGTREETECH S2DW V1.0"
                                   FontSize="18" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="LIS2DW12 Accelerometer"
                                   FontSize="14"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,5,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                            <TextBlock Text="Status: "
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="StatusText" Text="Disconnected"
                                       Foreground="{StaticResource XAxisBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Acceleration Values Card -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Acceleration (m/s²)"
                                   FontSize="18" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,15"/>

                        <!-- X Axis -->
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="X" FontSize="20" FontWeight="Bold"
                                       Foreground="{StaticResource XAxisBrush}" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Background="#1A1A2E" CornerRadius="4" Height="24" Margin="10,0">
                                <Canvas ClipToBounds="True">
                                    <Rectangle x:Name="XBar" Height="24" Fill="{StaticResource XAxisBrush}"
                                               Canvas.Left="0"/>
                                </Canvas>
                            </Border>
                            <TextBlock Grid.Column="2" x:Name="XValue" Text="0.00"
                                       FontSize="16" FontFamily="Consolas"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Y Axis -->
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Y" FontSize="20" FontWeight="Bold"
                                       Foreground="{StaticResource YAxisBrush}" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Background="#1A1A2E" CornerRadius="4" Height="24" Margin="10,0">
                                <Canvas ClipToBounds="True">
                                    <Rectangle x:Name="YBar" Height="24" Fill="{StaticResource YAxisBrush}"
                                               Canvas.Left="0"/>
                                </Canvas>
                            </Border>
                            <TextBlock Grid.Column="2" x:Name="YValue" Text="0.00"
                                       FontSize="16" FontFamily="Consolas"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Z Axis -->
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Z" FontSize="20" FontWeight="Bold"
                                       Foreground="{StaticResource ZAxisBrush}" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Background="#1A1A2E" CornerRadius="4" Height="24" Margin="10,0">
                                <Canvas ClipToBounds="True">
                                    <Rectangle x:Name="ZBar" Height="24" Fill="{StaticResource ZAxisBrush}"
                                               Canvas.Left="0"/>
                                </Canvas>
                            </Border>
                            <TextBlock Grid.Column="2" x:Name="ZValue" Text="0.00"
                                       FontSize="16" FontFamily="Consolas"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Magnitude -->
                        <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                            <TextBlock Text="Magnitude: "
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="14"/>
                            <TextBlock x:Name="MagnitudeValue" Text="0.00 m/s²"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="14" FontFamily="Consolas"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Orientation Card -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Screen Orientation"
                                   FontSize="18" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,15"/>

                        <!-- Current Orientation Display -->
                        <Border Background="#1A1A2E" CornerRadius="12" Padding="20" Margin="0,0,0,15">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="OrientationIcon" Text="&#x1F4F1;"
                                           FontSize="64" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="OrientationText" Text="Portrait"
                                           FontSize="24" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Manual Orientation Buttons (Demo Mode) -->
                        <TextBlock x:Name="DemoModeLabel" Text="Demo Mode - Simulate Orientation:"
                                   FontSize="14"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,10"
                                   Visibility="Collapsed"/>

                        <WrapPanel x:Name="OrientationButtons" HorizontalAlignment="Center">
                            <Button Content="Portrait" Style="{StaticResource OrientationButtonStyle}"
                                    Click="OrientationButton_Click" Tag="Portrait"/>
                            <Button Content="Landscape L" Style="{StaticResource OrientationButtonStyle}"
                                    Click="OrientationButton_Click" Tag="LandscapeLeft"/>
                            <Button Content="Landscape R" Style="{StaticResource OrientationButtonStyle}"
                                    Click="OrientationButton_Click" Tag="LandscapeRight"/>
                            <Button Content="Flipped" Style="{StaticResource OrientationButtonStyle}"
                                    Click="OrientationButton_Click" Tag="PortraitFlipped"/>
                            <Button Content="Face Up" Style="{StaticResource OrientationButtonStyle}"
                                    Click="OrientationButton_Click" Tag="FaceUp"/>
                            <Button Content="Face Down" Style="{StaticResource OrientationButtonStyle}"
                                    Click="OrientationButton_Click" Tag="FaceDown"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- 3D Visualization Card -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Device Visualization"
                                   FontSize="18" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,15"/>

                        <Canvas x:Name="VisualizationCanvas" Width="300" Height="300"
                                Background="#1A1A2E" HorizontalAlignment="Center">
                            <!-- Phone outline will be drawn here -->
                            <Rectangle x:Name="PhoneOutline"
                                       Width="80" Height="160"
                                       Stroke="{StaticResource AccentBrush}"
                                       StrokeThickness="3"
                                       RadiusX="8" RadiusY="8"
                                       Canvas.Left="110" Canvas.Top="70">
                                <Rectangle.RenderTransform>
                                    <RotateTransform x:Name="PhoneRotation" CenterX="40" CenterY="80"/>
                                </Rectangle.RenderTransform>
                            </Rectangle>
                            <!-- Screen indicator -->
                            <Rectangle x:Name="PhoneScreen"
                                       Width="60" Height="120"
                                       Fill="{StaticResource AccentBrush}"
                                       Opacity="0.3"
                                       Canvas.Left="120" Canvas.Top="90">
                                <Rectangle.RenderTransform>
                                    <RotateTransform x:Name="ScreenRotation" CenterX="30" CenterY="60"/>
                                </Rectangle.RenderTransform>
                            </Rectangle>
                            <!-- Top notch indicator -->
                            <Ellipse x:Name="PhoneNotch"
                                     Width="10" Height="10"
                                     Fill="{StaticResource AccentBrush}"
                                     Canvas.Left="145" Canvas.Top="78">
                                <Ellipse.RenderTransform>
                                    <RotateTransform x:Name="NotchRotation" CenterX="5" CenterY="77"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Canvas>
                    </StackPanel>
                </Border>

                <!-- Sensor Details Card -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Sensor Details"
                                   FontSize="18" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,15"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Chip:"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="LIS2DW12"
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,5"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Range:"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="±2g"
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,5"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Sample Rate:"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="100 Hz"
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,5"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Interface:"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="SPI"
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,5"/>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
